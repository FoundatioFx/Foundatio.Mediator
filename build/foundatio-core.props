<Project>
  <!-- This alternative compiles against an exact unreleased core revision. See setup-foundatio-core.ps1. -->
  <PropertyGroup>
    <FoundatioCorePath Condition="'$(FoundatioCorePath)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../.dependencies/Foundatio'))</FoundatioCorePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FoundatioCorePath)/src/Foundatio/Foundatio.csproj" />
  </ItemGroup>
  <Target Name="RequireFoundatioCoreSource" BeforeTargets="PrepareForBuild" Condition="!Exists('$(FoundatioCorePath)/src/Foundatio/Foundatio.csproj')">
    <Error Text="Run build/setup-foundatio-core.ps1 to fetch the pinned core source, or set FoundatioCorePath to a Foundatio checkout containing the native execution APIs." />
  </Target>
</Project>
