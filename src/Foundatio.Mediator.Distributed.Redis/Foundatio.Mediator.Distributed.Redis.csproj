<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <Import Project="..\..\build\distributed.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Foundatio.Mediator.Distributed.Redis</RootNamespace>
    <Description>Redis job state store for Foundatio.Mediator.Distributed: atomic status transitions, progress, heartbeats, cancellation, and per-queue counters.</Description>
    <PackageTags>$(PackageTags);Redis</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundatio.Mediator.Distributed\Foundatio.Mediator.Distributed.csproj" />
    <PackageReference Include="StackExchange.Redis" Version="2.12.14" />
  </ItemGroup>

</Project>
