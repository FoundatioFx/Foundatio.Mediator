<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <Import Project="..\..\build\distributed.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Foundatio.Mediator.Distributed.Testing</RootNamespace>
    <Description>Test doubles for Foundatio.Mediator.Distributed: a recording queue client with typed assertions and drain, and a shareable in-memory transport for multi-host tests.</Description>
    <PackageTags>$(PackageTags);Testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foundatio.Mediator.Distributed\Foundatio.Mediator.Distributed.csproj" />
  </ItemGroup>

</Project>
