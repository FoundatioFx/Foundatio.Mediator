<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1510;ASPIRE010</NoWarn>
    <!-- Fixtures use SDK-managed orchestration and must not rewrite the repository CLI appHost selection. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <TreatProjectReferencesAsResources>false</TreatProjectReferencesAsResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Foundatio.Xunit.v3" Version="13.0.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Foundatio.Mediator.Distributed\Foundatio.Mediator.Distributed.csproj" />
    <ProjectReference Include="..\..\src\Foundatio.Mediator.Distributed.Redis\Foundatio.Mediator.Distributed.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Foundatio.Mediator.Distributed.Tests/QueueJobStateStoreContractTests.cs" Link="QueueJobStateStoreContractTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(RequireDistributedIntegrationTests)' == 'true'">
    <None Include="../integration.testconfig.json" Link="$(AssemblyName).testconfig.json" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
